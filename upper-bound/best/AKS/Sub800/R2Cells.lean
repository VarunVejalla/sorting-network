theorem edges_mono : ∀ i, i < 58 → edge i ≤ edge (i + 1) := by
  intro i hi
  interval_cases i <;> norm_num [edge]

theorem cover : ∀ p : ℝ, 0 ≤ p → p ≤ 1 / 2 → ∃ i : Fin 58, edge i ≤ p ∧ p ≤ edge (i + 1) := by
  intro p h0 h1
  obtain ⟨i, hi, h⟩ := CellLemmas2.cover_of_edges_top 58 (by norm_num) edge (1 / 2) (by norm_num [edge]) (by norm_num [edge]) edges_mono p h0 h1
  exact ⟨⟨i, hi⟩, h⟩

open Classical in
/-- **Round 2 of the walk bound, numerically closed**: for every `n ≥ 16` and every row count
`50859009 ≤ m ≤ 2^26`, at most 1/1000 of the scrambles fail Property B2 with `E1 = 3.68420e-04`, `d = 1/105000`. -/
theorem round2_numeric {m n : ℕ} (hn : 16 ≤ n) (hmM : (50859009 : ℝ) ≤ m) (hmHi : m ≤ 67108864) (hm : 0 < m) :
    ((Finset.univ.filter fun σ : Chvatal.Scramble m n => ¬ Chvatal.HasCombinatorialPropertyB2 σ (18421 / 50000000 : ℝ) (1 / 105000 : ℝ)).card : ℝ) ≤
      (1 / 1000 : ℝ) * ((Fintype.card (Chvatal.Scramble m n) : ℕ) : ℝ) :=
  Round2Num.round2_bound (18421 / 50000000 : ℝ) (1 / 105000 : ℝ) (50859009 : ℝ) (1 / 1000 : ℝ) (120949064204322316112680895152680060001023 / 10000000000000000000000000000000000000000 : ℝ) 187 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (fun i => edge i) (fun i => edge (i + 1)) (fun i => lamf i) (fun i => tf i) (fun i => alf i) (fun i => bef i)
    cover cells_ok hn hmM hm (hlnG m hmHi)


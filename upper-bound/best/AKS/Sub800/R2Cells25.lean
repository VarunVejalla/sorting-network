open Classical in
/-- **Round 2 of the walk bound, numerically closed**: for every `n ≥ 16` and every row count
`27254890 ≤ m ≤ 2^26`, at most 1/1000 of the scrambles fail Property B2 with `E1 = 5.04000e-04`, `d = 1/105000`. -/
theorem round2_numeric {m n : ℕ} (hn : 16 ≤ n) (hmM : (27254890 : ℝ) ≤ m) (hmHi : m ≤ 33554432) (hm : 0 < m) :
    ((Finset.univ.filter fun σ : Chvatal.Scramble m n => ¬ Chvatal.HasCombinatorialPropertyB2 σ (63 / 125000 : ℝ) (1 / 70000 : ℝ)).card : ℝ) ≤
      (1 / 1000 : ℝ) * ((Fintype.card (Chvatal.Scramble m n) : ℕ) : ℝ) := by
  have hE1 : ((glob.E1 : ℚ) : ℝ) = (63 / 125000 : ℝ) := by norm_num [glob]
  have hd : ((glob.d : ℚ) : ℝ) = (1 / 70000 : ℝ) := by norm_num [glob]
  have hη : ((glob.η : ℚ) : ℝ) = (1 / 1000 : ℝ) := by norm_num [glob]
  have hM : ((glob.M : ℚ) : ℝ) = (27254890 : ℝ) := by norm_num [glob]
  have hg : 2 * glob.gp + 1 = 275 := by norm_num [glob]
  have h := CellCheck2.round2_of_cert glob cells cells_checked hn (by rw [hM]; exact hmM) hm
    (by rw [hg]; exact hlnG m hmHi)
  rwa [hE1, hd, hη] at h

end R2Cells25

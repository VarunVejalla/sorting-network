theorem round1_numeric {m n : ℕ} (hn : 16 ≤ n) (hmM : (50859009 : ℝ) ≤ m) (hm : 0 < m) :
    ((Finset.univ.filter fun σ : Chvatal.Scramble m n => ¬ Chvatal.HasCombinatorialPropertyBOnPipeline σ (18421 / 50000000 : ℝ)).card : ℝ) ≤
      (1 / 100 : ℝ) * ((Fintype.card (Chvatal.Scramble m n) : ℕ) : ℝ) := by
  have hE1 : ((glob.E1 : ℚ) : ℝ) = (18421 / 50000000 : ℝ) := by norm_num [glob]
  have hη : ((glob.η : ℚ) : ℝ) = (1 / 100 : ℝ) := by norm_num [glob]
  have hM : ((glob.M : ℚ) : ℝ) = (50859009 : ℝ) := by norm_num [glob]
  have h := CellCheck1.round1_of_cert glob cells cells_checked hn (by rw [hM]; exact hmM) hm
  rwa [hE1, hη] at h

end R1Cells

open Classical in
/-- **Round 1 of the walk bound, numerically closed**: for every `n ≥ 16` and every row count
`m ≥ 27254890`, at most 1/100 of the scrambles fail the pipeline Property B with `E1 = 5.04000e-04`. -/
theorem round1_numeric {m n : ℕ} (hn : 16 ≤ n) (hmM : (27254890 : ℝ) ≤ m) (hm : 0 < m) :
    ((Finset.univ.filter fun σ : Chvatal.Scramble m n => ¬ Chvatal.HasCombinatorialPropertyBOnPipeline σ (63 / 125000 : ℝ)).card : ℝ) ≤
      (1 / 100 : ℝ) * ((Fintype.card (Chvatal.Scramble m n) : ℕ) : ℝ) := by
  have hE1 : ((glob.E1 : ℚ) : ℝ) = (63 / 125000 : ℝ) := by norm_num [glob]
  have hη : ((glob.η : ℚ) : ℝ) = (1 / 100 : ℝ) := by norm_num [glob]
  have hM : ((glob.M : ℚ) : ℝ) = (27254890 : ℝ) := by norm_num [glob]
  have h := CellCheck1.round1_of_cert glob cells cells_checked hn (by rw [hM]; exact hmM) hm
  rwa [hE1, hη] at h

end R1Cells25

def unary (delta column height : Nat) : Int :=
  (if (17 * ((64 - column) % 64)) % 64 < height then 1 else 0) +
    (if height ≤ (17 * ((delta + 64 - column) % 64)) % 64 then 1 else 0)

def suffixStepCheck (delta layer height : Nat) : Bool :=
  if height < 64 then
    decide (suffixes[delta]![layer]![height]! =
      min (potentials[delta]![layer]![height]!)
        (suffixes[delta]![layer]![height + 1]!))
  else decide (suffixes[delta]![layer]![64]! =
    potentials[delta]![layer]![64]!)

def localCheck (delta layer current : Nat) : Bool :=
  let height := current - 1
  let threshold := if current = 0 then 0 else height
  decide (unary delta ((35 * layer) % 64) current ≤
    budgets[delta]![layer]! +
      suffixes[delta]![(layer + 63) % 64]![threshold]! -
        potentials[delta]![layer]![current]!)

def deltaCheck (delta : Nat) : Bool :=
  (List.range 64).all fun layer =>
    (List.range 65).all (suffixStepCheck delta layer) &&
    (List.range 65).all (localCheck delta layer)


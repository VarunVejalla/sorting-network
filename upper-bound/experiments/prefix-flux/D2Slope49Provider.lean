theorem certificate_edge (delta layer : Col) (current previous : Height)
    (htransition : current.val ≤ previous.val + 1) :
    unary delta layer current ≤
      certificateBudget delta layer +
        certificatePotential delta (predecessor layer) previous -
          certificatePotential delta layer current := by
  fin_cases delta
  · simpa [certificateBudget, certificatePotential,
      Chvatal.D2Slope49Abstract.unary,
      Chvatal.D2Slope49Certificate0.unary] using
      Chvatal.D2Slope49Certificate0.delta_edge_inequality
        layer current previous htransition
  · simpa [certificateBudget, certificatePotential,
      Chvatal.D2Slope49Abstract.unary,
      Chvatal.D2Slope49Certificate1.unary] using
      Chvatal.D2Slope49Certificate1.delta_edge_inequality
        layer current previous htransition
  · simpa [certificateBudget, certificatePotential,
      Chvatal.D2Slope49Abstract.unary,
      Chvatal.D2Slope49Certificate2.unary] using
      Chvatal.D2Slope49Certificate2.delta_edge_inequality
        layer current previous htransition
  · simpa [certificateBudget, certificatePotential,
      Chvatal.D2Slope49Abstract.unary,

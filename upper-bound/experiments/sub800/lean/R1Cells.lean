theorem edges_mono : ∀ i, i < 117 → edge i ≤ edge (i + 1) := by
  intro i hi
  interval_cases i <;> norm_num [edge]

theorem cover : ∀ p : ℝ, 0 ≤ p → p ≤ 1 → ∃ i : Fin 117, edge i ≤ p ∧ p ≤ edge (i + 1) := by
  intro p h0 h1
  obtain ⟨i, hi, h⟩ := CellLemmas.cover_of_edges 117 (by norm_num) edge (by norm_num [edge]) (by norm_num [edge]) edges_mono p h0 h1
  exact ⟨⟨i, hi⟩, h⟩

open Classical in
/-- **Round 1 of the walk bound, numerically closed**: for every `n ≥ 16` and every row count
`m ≥ 50859009`, at most 1/100 of the scrambles fail the pipeline Property B with `E1 = 3.68420e-04`. -/
theorem round1_numeric {m n : ℕ} (hn : 16 ≤ n) (hmM : (50859009 : ℝ) ≤ m) (hm : 0 < m) :
    ((Finset.univ.filter fun σ : Chvatal.Scramble m n => ¬ Chvatal.HasCombinatorialPropertyBOnPipeline σ (18421 / 50000000 : ℝ)).card : ℝ) ≤
      (1 / 100 : ℝ) * ((Fintype.card (Chvatal.Scramble m n) : ℕ) : ℝ) :=
  Round1Num.round1_bound (18421 / 50000000 : ℝ) (50859009 : ℝ) (1 / 100 : ℝ) (by norm_num) (by norm_num) (by norm_num)
    (fun i => edge i) (fun i => edge (i + 1)) (fun i => lamf i) (fun i => tf i) (fun i => alf i)
    cover cells_ok hn hmM hm

end R1Cells

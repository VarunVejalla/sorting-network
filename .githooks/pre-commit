#!/bin/bash
# Pre-commit hook: block commits with forbidden markers in protected files.
# Enable: git config core.hooksPath .githooks

set -o pipefail
# NUL-separated input handles spaces and large reorganizations without
# exceeding Windows command-line limits.
git diff --cached --name-only --diff-filter=ACMR -z -- '*.lean' |
    "$(git rev-parse --show-toplevel)/scripts/sorry-gate" --stdin0
